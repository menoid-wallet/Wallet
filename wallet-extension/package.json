{
  "name": "wallet-extension",
  "displayName": "Menoid",
  "version": "0.0.1",
  "description": "Menoid - An Ai Native Private Smart Wallet for Monad",
  "author": "Mahesh K; Karthik J",
  "plasmo": {
    "defaultTitle": "Menoid"
  },
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package"
  },
  "dependencies": {
    "circomlibjs": "^0.1.7",
    "ethers": "^6.16.0",
    "plasmo": "0.90.5",
    "poseidon-lite": "^0.3.0",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@types/chrome": "0.0.258",
    "@types/node": "20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.15",
    "prettier": "3.2.4",
    "tailwindcss": "^3.4.3",
    "typescript": "5.3.3"
  },
  "manifest": {
    "permissions": [
      "storage","sidePanel"
    ],

    "side_panel": {
      "default_path": "sidepanel.html"
    },
    "host_permissions": [
      "https://*/*"
    ],
    "content_security_policy": {
      "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
    }
  }
}
