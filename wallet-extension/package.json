{
  "name": "wallet-extension",
  "displayName": "Menoid",
  "version": "0.0.1",
  "description": "Menoid - An Ai Native Private Smart Wallet for Monad",
  "author": "Mahesh K; Karthik J",
  "plasmo": {
    "defaultTitle": "Menoid"
  },
  "scripts": {
    "build:inpage": "esbuild lib/inpage.ts --bundle --format=iife --outfile=assets/inpage.js --platform=browser",
    "dev": "npm run build:inpage && plasmo dev",
    "build": "npm run build:inpage && plasmo build"
  },
  "dependencies": {
    "@noble/ciphers": "^1.3.0",
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "@types/qrcode": "^1.5.6",
    "@zk-kit/incremental-merkle-tree": "^1.1.0",
    "circomlibjs": "^0.1.7",
    "eciesjs": "^0.3.19",
    "ethers": "^6.16.0",
    "plasmo": "0.90.5",
    "poseidon-lite": "^0.3.0",
    "qrcode": "^1.5.4",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "snarkjs": "^0.7.6"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@types/chrome": "0.0.258",
    "@types/node": "20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "autoprefixer": "^10.5.0",
    "esbuild": "^0.28.0",
    "postcss": "^8.5.15",
    "prettier": "3.2.4",
    "tailwindcss": "^3.4.3",
    "typescript": "5.3.3"
  },
  "manifest": {
    "permissions": [
      "storage",
      "sidePanel",
      "tabs",
      "activeTab"
    ],
    "side_panel": {
      "default_path": "sidepanel.html"
    },
    "host_permissions": [
      "https://*/*",
      "http://localhost/*",
      "http://127.0.0.1/*"
    ],
    "content_security_policy": {
      "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; connect-src 'self' https://*.monad.xyz https://*.pinata.cloud https://ipfs.io wss://*.monad.xyz https://*.onrender.com http://localhost:* http://127.0.0.1:* https://rpc.ankr.com https://*.ankr.com https://*.publicnode.com https://1rpc.io https://*.g.alchemy.com https://*.alchemyapi.io https://84532.rpc.thirdweb.com https://*.etherscan.io https://basescan.org https://*.basescan.org; object-src 'self';"
    },
    "web_accessible_resources": [
      {
        "resources": [
          "assets/inpage.js",
          "assets/zk/*"
        ],
        "matches": [
          "<all_urls>"
        ]
      }
    ]
  },
  "alias": {
    "eciesjs": "eciesjs/dist/index.browser.js",
    "ejs": "./stubs/empty.js"
  }
}